# Dependências — sempre reinstaladas via "npm install".
node_modules/
server/node_modules/

# Backups locais avulsos (o histórico do git já cumpre esse papel)
*.bak
*.bak_*

# Dumps de backup do banco (pg_dump — ver server/index.js, GET/POST
# /api/backups). Ficam só no volume do container toolbox45-backend
# (/app/backups); nunca versionados. O banco em si (PostgreSQL) vive inteiramente
# no container toolbox45-db + seu próprio volume nomeado — não há mais
# nenhum arquivo de banco de dados dentro deste repositório (antes era
# server/commands.db, SQLite; removido junto com a migração para Postgres).
server/backup/
/backup/

# Segredos (POSTGRES_PASSWORD, GOOGLE_CLIENT_SECRET etc. — ver
# docker-compose.yml, que os lê via ${VAR} de um .env ao lado dele, nunca
# com o valor escrito direto no próprio docker-compose.yml). Este repo é
# PÚBLICO — um .env aqui nunca pode ser versionado.
.env
.env.*
!.env.example

# Lixo comum de SO/editor
.DS_Store
Thumbs.db
.vscode/
.idea/
