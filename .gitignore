# Dependências do frontend — sempre reinstaladas via "npm install"/"npm ci".
node_modules/

# Backups locais avulsos (o histórico do git já cumpre esse papel)
*.bak
*.bak_*

# Dumps de backup do banco (pg_dump — ver server-py/app/backup.py, GET/POST
# /api/backups). Ficam só no volume do container toolbox45-backend
# (/app/backups); nunca versionados. O banco em si (PostgreSQL) vive inteiramente
# no container toolbox45-db + seu próprio volume nomeado — não há nenhum
# arquivo de banco de dados dentro deste repositório.
/backup/

# Segredos (POSTGRES_PASSWORD, GOOGLE_CLIENT_SECRET etc. — ver
# docker-compose.yml, que os lê via ${VAR} de um .env ao lado dele, nunca
# com o valor escrito direto no próprio docker-compose.yml). Este repo é
# PÚBLICO — um .env aqui nunca pode ser versionado.
.env
.env.*
!.env.example

# Lixo comum de SO/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Backend Python (server-py/) -- Fase 1 da migracao (Project toolbox45).
# Ambiente virtual e cache de bytecode nunca sao versionados (mesmo
# racional do node_modules/ acima, so que pro lado Python).
server-py/.venv/
server-py/venv/
__pycache__/
*.pyc

# Cache do pytest (server-py/tests)
.pytest_cache/

# Saída de trabalho do Claude (patches, runbooks) — não faz parte do projeto.
Claude outputs/
